// Mindmorph Edubridge — Prisma schema
// Spec §5 (Admin Dashboard & CMS) / §7 (Technology Stack).
// Database is MySQL per the spec; lift-and-shift to Postgres only changes the provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONSULTANT
  VIEWER
}

enum LeadStage {
  NEW
  CONTACTED
  CONSULTATION_BOOKED
  ACTIVE
  VISA_STAGE
  PLACED
  LOST
}

enum LeadSource {
  WEBSITE_FORM
  WHATSAPP
  REFERRAL
  WALK_IN
  SOCIAL
  EVENT
  OTHER
}

enum BookingFormat {
  VIDEO
  IN_PERSON
  PHONE
}

enum OriginCountry {
  GH
  NG
  CI
  TG
  BF
  LR
  OTHER
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  role          Role        @default(VIEWER)
  passwordHash  String?
  twoFactorAuth Boolean     @default(false)
  bio           String?     @db.Text
  photoUrl      String?
  languages     String?
  specialisations String?
  active        Boolean     @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  assignedLeads Lead[]      @relation("ConsultantLeads")
  bookings      Booking[]
  auditLogs     AuditLog[]
}

model Lead {
  id                 String         @id @default(cuid())
  fullName           String
  whatsappNumber     String
  email              String?
  country            OriginCountry
  educationLevel     String
  serviceInterest    String         // CSV — multi-select
  targetDestinations String?        // CSV — multi-select
  timeline           String?
  source             LeadSource     @default(WEBSITE_FORM)
  stage              LeadStage      @default(NEW)
  notes              String?        @db.Text
  consultantId       String?
  consultant         User?          @relation("ConsultantLeads", fields: [consultantId], references: [id])
  bookings           Booking[]
  documents          LeadDocument[]
  createdAt          DateTime       @default(now())
  lastActivityAt     DateTime       @updatedAt

  @@index([stage])
  @@index([consultantId])
}

model LeadDocument {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())
}

model Booking {
  id             String        @id @default(cuid())
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  consultantId   String?
  consultant     User?         @relation(fields: [consultantId], references: [id])
  scheduledFor   DateTime
  format         BookingFormat @default(VIDEO)
  serviceType    String
  status         String        @default("SCHEDULED") // SCHEDULED | COMPLETED | NO_SHOW | CANCELLED
  externalEventId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([scheduledFor])
}

model Scholarship {
  id           String   @id @default(cuid())
  name         String
  destination  String
  level        String
  subjectArea  String?
  awardValue   String
  deadline     DateTime
  eligibility  String   @db.Text
  link         String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([destination])
  @@index([deadline])
}

model SuccessStory {
  id              String   @id @default(cuid())
  studentName     String
  photoUrl        String?
  originCountry   String
  destinationUni  String
  destinationCty  String
  programme       String
  graduationYear  Int?
  quote           String   @db.Text
  fullStory       String?  @db.Text
  videoUrl        String?
  featured        Boolean  @default(false)
  serviceType     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Article {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String   @db.Text
  body          String   @db.LongText
  category      String
  tags          String?
  authorId      String?
  featuredImage String?
  ogImage       String?
  metaTitle     String?
  metaDesc      String?
  readTimeMin   Int      @default(5)
  status        String   @default("DRAFT") // DRAFT | REVIEW | PUBLISHED
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, publishedAt])
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  startsAt    DateTime
  endsAt      DateTime?
  format      String   // ONLINE | IN_PERSON
  location    String?
  recordingUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  segments  String?  // CSV — admissions, scholarships, test_prep, etc.
  country   String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
