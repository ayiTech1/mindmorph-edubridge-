# ─── Mindmorph Edubridge — environment variables ─────────────────────────
# Copy to `.env.local` and fill values. Never commit secrets.

# Public site URL — used for canonical/OG/sitemap.
NEXT_PUBLIC_SITE_URL=https://mindmorphedubridge.com

# WhatsApp Business — primary contact channel.
NEXT_PUBLIC_WHATSAPP_NUMBER=233000000000
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hi Mindmorph, I'd like to know more about studying abroad."

# Twilio (or Meta Cloud API) for transactional WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# HubSpot CRM.
HUBSPOT_API_KEY=

# Resend / SendGrid for transactional email.
RESEND_API_KEY=
EMAIL_FROM="Mindmorph Edubridge <hello@mindmorphedubridge.com>"

# MySQL (Prisma) — primary application database (leads, bookings, users).
DATABASE_URL="mysql://user:password@localhost:3306/mindmorph"

# NextAuth.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Google OAuth (optional admin SSO).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Sanity (Phase 2 — headless CMS).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Cal.com / Calendly booking embed.
# Leave NEXT_PUBLIC_CALCOM_USER blank to render a placeholder. Set it to your
# Cal.com username (e.g. "mindmorph") to mount the inline calendar on /book.
NEXT_PUBLIC_CALCOM_USER=
NEXT_PUBLIC_CALCOM_EVENT=consultation

# Payments.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# reCAPTCHA v3 — public forms.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Tawk.to live chat (spec §6.8) — leave blank to disable.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
